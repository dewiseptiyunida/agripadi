APP_ENV=development
APP_PORT=8181

DATABASE_DSN=postgres://agripadi:CHANGE_ME@127.0.0.1:5432/agripadi?sslmode=disable
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

LLM_PROVIDER=groq
