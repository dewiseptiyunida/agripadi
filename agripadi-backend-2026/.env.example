LLM_API_KEY=REPLACE_WITH_YOUR_GROQ_KEY
LLM_MODEL=qwen/qwen3.6-27b
LLM_TIMEOUT=30s

CNN_MODE=on_device_flutter
CNN_URL=

LOG_LEVEL=info
LOG_DEBUG=false
